# Caddy: HTTPS-сертификат Let's Encrypt получает и продлевает сам.
# Домен — из переменной SITE_DOMAIN в .env на сервере.
{
	email {$ACME_EMAIL}
}

# Общая часть: сайт отдаётся одинаково на домене и на внутренней проверке.
(site) {
	root * /var/www/html/public
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000"
	}

	# Файлы сборки с хешем в имени — кешировать надолго.
	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Пока при обновлении перезапускается PHP, Caddy не отдаёт 502,
	# а повторяет запрос до 30 секунд — посетитель видит паузу, не ошибку.
	php_fastcgi app:9000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
	file_server
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	import site
}

# Внутренняя проверка «сайт отвечает» для deploy/update.sh: наружу не открыт.
:8080 {
	bind 127.0.0.1
	import site
}
