# Шаблон окружения. Реальные значения — только в .env (он в .gitignore).
# Пустые секреты (APP_KEY, DB_PASSWORD) заполняет bin/setup.

APP_NAME="ЭлектроСтрой Марий Эл"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

# Данные компании для сайта: меняются здесь, в коде и шаблонах их нет
SITE_COMPANY_NAME="ЭлектроСтрой Марий Эл"
SITE_CITY="Йошкар-Ола"
SITE_CITY_IN="Йошкар-Оле"
SITE_REGION="Республика Марий Эл"
SITE_ADDRESS=""
SITE_PHONE=""
SITE_EMAIL=""
# Ссылка для кнопки «Написать в Telegram», только https://t.me/...
SITE_TELEGRAM=""
# Ссылка на канал в MAX, только https://max.ru/... Пусто — ссылок на канал нет.
SITE_MAX_CHANNEL=""
# Группа ВКонтакте, только https://vk.ru/... или https://vk.com/...
SITE_VK=""
# Ключ IndexNow (8–128 символов: латиница, цифры, дефис). На сервере
# его создаёт deploy/update.sh. Пусто — о новых страницах Яндексу не сообщаем.
SITE_INDEXNOW_KEY=""
# Номер счётчика Яндекс Метрики (только цифры). Пусто — без Метрики.
YANDEX_METRIKA_ID=""
SITE_WORK_HOURS="Пн–Пт: 9:00–18:00"
# Почта для заявок при первой заливке демо-данных; дальше меняется в админке
SITE_NOTIFY_EMAIL=""
# Реквизиты продавца для подвала и политики: «ИП Фамилия Имя Отчество», ИНН (12 цифр), ОГРНИП (15 цифр)
SITE_LEGAL_NAME=""
SITE_INN=""
SITE_OGRNIP=""

# Недельная копия наружу (deploy/offsite-backup.sh). Значения записывает
# deploy/offsite-setup.sh на сервере; локально не нужны.
BACKUP_MAIL_TO=
BACKUP_ARCHIVE_PASSWORD=
YANDEX_DISK_LOGIN=
YANDEX_DISK_APP_PASSWORD=

# Токен Telegram-бота от @BotFather. Пусто — Telegram выключен.
TELEGRAM_BOT_TOKEN=
# Пересыльщик до Telegram (с российского сервера напрямую не открывается):
# https://адрес/секретный-путь. Секрет — только в .env на сервере.
TELEGRAM_API_URL=

# «Тендер-Радар»: заявки с сайта уходят в его воронку сделок. Адрес
# https://tender.es12.ru/api/leads, токен — как LEADS_API_TOKEN там.
# Пусто — передача выключена.
TENDER_RADAR_LEADS_URL=
TENDER_RADAR_LEADS_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=electro
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Docker (Sail)
WWWGROUP=1000
WWWUSER=1000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
VITE_PORT=5173
