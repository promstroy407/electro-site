# Что не попадает в боевой образ: секреты, локальные зависимости и сборки,
# пользовательские файлы (на сервере они в томе storage), тесты.
.git
.github
.githooks
.env
.env.*
vendor
node_modules
public/build
public/hot
public/storage
public/css/filament
public/js/filament
public/fonts/filament
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/app/public/*
!storage/**/.gitignore
bootstrap/cache/*.php
tests
.phpunit.cache
.phpstan-cache
